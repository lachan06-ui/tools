  "EnemyAI.tick" -> "EnemyAI._update_attack" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._update_feed" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._update_movement" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._update_return" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._validate_owner" [color="#64748B"];
  "GroupPoisonState.get_avoidance_weight" -> "GroupPoisonState._get_species" [color="#64748B"];
  "GroupPoisonState.get_avoidance_weight" -> "GroupPoisonState.get_tolerance" [color="#64748B"];
  "GroupPoisonState.get_tolerance" -> "GroupPoisonState._get_species" [color="#64748B"];
  "GroupPoisonState.get_tolerance" -> "GroupPoisonState._key" [color="#64748B"];
  "NutrientCycle.excrete" -> "NutrientCycle._add_detritus" [color="#64748B"];
  "PoisonAvoidance.compute" -> "GroupPoisonState.get_avoidance_weight" [color="#64748B"];
  "PoisonAvoidance.compute" -> "GroupPoisonState.get_tolerance" [color="#64748B"];
  "PoisonAvoidance.steer" -> "PoisonAvoidance.compute" [color="#64748B"];
}
