digraph "trace" {
  rankdir="LR";
  bgcolor="white";
  graph [fontname="Noto Sans CJK JP", pad="0.3"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11];
  edge [fontname="Noto Sans CJK JP", fontsize=9];
  "EnemyAI.tick" [label="EnemyAI.tick", fillcolor="#DCEBFA", penwidth=3];
  "EnemyAI._acquire_food_source" [label="EnemyAI._acquire_food_source", fillcolor="#DCEBFA"];
  "EnemyAI._acquire_target" [label="EnemyAI._acquire_target", fillcolor="#DCEBFA"];
  "EnemyAI._apply_poison_steering" [label="EnemyAI._apply_poison_steering", fillcolor="#DCEBFA"];
  "EnemyAI._is_attached" [label="EnemyAI._is_attached", fillcolor="#DCEBFA"];
  "EnemyAI._is_frozen" [label="EnemyAI._is_frozen", fillcolor="#DCEBFA"];
  "EnemyAI._is_knockbacked" [label="EnemyAI._is_knockbacked", fillcolor="#DCEBFA"];
  "EnemyAI._stop_movement" [label="EnemyAI._stop_movement", fillcolor="#DCEBFA"];
  "EnemyAI._transition_state" [label="EnemyAI._transition_state", fillcolor="#DCEBFA"];
  "EnemyAI._update_attack" [label="EnemyAI._update_attack", fillcolor="#DCEBFA"];
  "EnemyAI._update_feed" [label="EnemyAI._update_feed", fillcolor="#DCEBFA"];
  "EnemyAI._update_movement" [label="EnemyAI._update_movement", fillcolor="#DCEBFA"];
  "EnemyAI._update_return" [label="EnemyAI._update_return", fillcolor="#DCEBFA"];
  "EnemyAI._validate_owner" [label="EnemyAI._validate_owner", fillcolor="#DCEBFA"];
  "PoisonAvoidance.steer" [label="PoisonAvoidance.steer", fillcolor="#E3F4DC"];
  "EnemyAI._get_autoload" [label="EnemyAI._get_autoload", fillcolor="#DCEBFA"];
  "EnemyAI._get_return_target" [label="EnemyAI._get_return_target", fillcolor="#DCEBFA"];
  "EnemyAI._get_territory_radius" [label="EnemyAI._get_territory_radius", fillcolor="#DCEBFA"];
  "EnemyAI._consume_food" [label="EnemyAI._consume_food", fillcolor="#DCEBFA"];
  "PoisonAvoidance.compute" [label="PoisonAvoidance.compute", fillcolor="#E3F4DC"];
  "EnemyAI._get_territory_state" [label="EnemyAI._get_territory_state", fillcolor="#DCEBFA"];
  "NutrientCycle.excrete" [label="NutrientCycle.excrete", fillcolor="#E3F4DC"];
  "GroupPoisonState.get_avoidance_weight" [label="GroupPoisonState.get_avoidance_weight", fillcolor="#E3F4DC"];
  "GroupPoisonState.get_tolerance" [label="GroupPoisonState.get_tolerance", fillcolor="#E3F4DC"];
  "NutrientCycle._add_detritus" [label="NutrientCycle._add_detritus", fillcolor="#E3F4DC"];
  "GroupPoisonState._get_species" [label="GroupPoisonState._get_species", fillcolor="#E3F4DC"];
  "GroupPoisonState._key" [label="GroupPoisonState._key", fillcolor="#E3F4DC"];
  "EnemyAI._apply_poison_steering" -> "PoisonAvoidance.steer" [color="#64748B"];
  "EnemyAI._consume_food" -> "EnemyAI._get_territory_radius" [color="#64748B"];
  "EnemyAI._consume_food" -> "NutrientCycle.excrete" [color="#64748B"];
  "EnemyAI._get_return_target" -> "EnemyAI._get_territory_state" [color="#64748B"];
  "EnemyAI._get_territory_radius" -> "EnemyAI._get_territory_state" [color="#64748B"];
  "EnemyAI._is_attached" -> "EnemyAI._get_autoload" [color="#64748B"];
  "EnemyAI._transition_state" -> "EnemyAI._get_return_target" [color="#64748B"];
  "EnemyAI._transition_state" -> "EnemyAI._get_territory_radius" [color="#64748B"];
  "EnemyAI._update_feed" -> "EnemyAI._consume_food" [color="#64748B"];
  "EnemyAI._update_feed" -> "EnemyAI._stop_movement" [color="#64748B"];
  "EnemyAI._update_feed" -> "EnemyAI._stop_movement" [color="#64748B"];
  "EnemyAI._update_return" -> "EnemyAI._get_return_target" [color="#64748B"];
  "EnemyAI._update_return" -> "EnemyAI._stop_movement" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._acquire_food_source" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._acquire_target" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._apply_poison_steering" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._is_attached" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._is_frozen" [color="#64748B"];
  "EnemyAI.tick" -> "EnemyAI._is_knockbacked" [color="#64748B"];
