digraph "domains" {
  rankdir="LR";
  bgcolor="transparent";
  graph [fontname="Noto Sans CJK JP", pad="0.3"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11];
  edge [fontname="Noto Sans CJK JP", fontsize=9];
  "combat" [label="combat\n(5)", fillcolor="#DCEBFA"];
  "core" [label="core\n(6)", fillcolor="#E3F4DC"];
  "crafting" [label="crafting\n(2)", fillcolor="#FCE8D5"];
  "ecology" [label="ecology\n(31)", fillcolor="#F2DDF3"];
  "enemy" [label="enemy\n(15)", fillcolor="#FFF4C2"];
  "feedback" [label="feedback\n(4)", fillcolor="#D8F0EE"];
  "item" [label="item\n(5)", fillcolor="#F8D9D9"];
  "map" [label="map\n(17)", fillcolor="#E6E6F5"];
  "npc" [label="npc\n(2)", fillcolor="#EAEAEA"];
  "player" [label="player\n(9)", fillcolor="#DDEBD0"];
  "quest" [label="quest\n(2)", fillcolor="#F5E1C8"];
  "save" [label="save\n(2)", fillcolor="#D5E3F0"];
  "spell" [label="spell\n(3)", fillcolor="#DCEBFA"];
  "status" [label="status\n(3)", fillcolor="#E3F4DC"];
  "time" [label="time\n(1)", fillcolor="#FCE8D5"];
  "core" -> "ecology" [color="#64748B", penwidth=4.0, label="9"];
  "core" -> "enemy" [color="#64748B", penwidth=2.0, label="3"];
  "core" -> "map" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="region_changed"];
  "core" -> "player" [color="#64748B", penwidth=1.7, label="2"];
  "core" -> "player" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="spell_discovered"];
  "core" -> "status" [color="#64748B", penwidth=2.0, label="3"];
  "crafting" -> "player" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="crafting_completed, crafting_started"];
  "ecology" -> "core" [color="#64748B", penwidth=2.3, label="4"];
  "ecology" -> "enemy" [color="#64748B", penwidth=3.0, label="6"];
  "ecology" -> "map" [color="#64748B", penwidth=2.0, label="3"];
  "ecology" -> "map" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="swarm_event_requested"];
  "enemy" -> "combat" [color="#64748B", penwidth=2.3, label="4"];
  "enemy" -> "core" [color="#64748B", penwidth=3.3, label="7"];
  "enemy" -> "ecology" [color="#64748B", penwidth=5.0, label="21"];
  "enemy" -> "map" [color="#64748B", penwidth=1.7, label="2"];
  "enemy" -> "player" [color="#64748B", penwidth=1.7, label="2"];
  "map" -> "combat" [color="#64748B", penwidth=2.7, label="5"];
  "map" -> "core" [color="#64748B", penwidth=2.7, label="5"];
  "map" -> "ecology" [color="#64748B", penwidth=5.0, label="15"];
  "map" -> "ecology" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="spawn_requested"];
  "map" -> "enemy" [color="#64748B", penwidth=2.7, label="5"];
  "map" -> "player" [color="#64748B", penwidth=2.0, label="3"];
  "player" -> "combat" [color="#64748B", penwidth=4.0, label="9"];
  "player" -> "core" [color="#64748B", penwidth=2.7, label="5"];
  "player" -> "crafting" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="crafting_interrupted"];
  "player" -> "enemy" [color="#64748B", penwidth=1.7, label="2"];
  "player" -> "map" [color="#64748B", penwidth=1.7, label="2"];
  "player" -> "npc" [color="#64748B", penwidth=1.7, label="2"];
  "quest" -> "ecology" [color="#64748B", penwidth=2.3, label="4"];
  "quest" -> "enemy" [color="#64748B", penwidth=1.7, label="2"];
  "save" -> "core" [color="#64748B", penwidth=2.3, label="4"];
  "save" -> "ecology" [color="#64748B", penwidth=1.7, label="2"];
  "save" -> "quest" [color="#64748B", penwidth=1.7, label="2"];
  "spell" -> "core" [color="#64748B", penwidth=1.7, label="2"];
  "spell" -> "player" [style=dashed, color="#2563EB", fontcolor="#2563EB", label="spell_discovered"];
}
